{
  "manifest_version": 3,
  "name": "LiteGesture",
  "version": "2.0.1",
  "description": "Customizable mouse gestures for tab and page navigation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "sessions",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}